# FinSentinel Environment Configuration

# Application Security
SECRET_KEY=replace-with-a-long-random-secret-before-deployment

# Database (Default: SQLite for lightweight local dev; or PostgreSQL: postgresql://user:pass@localhost:5432/finsentinel)
DATABASE_URL=sqlite:///./finsentinel.db

# Optional Google Gemini API Key for natural language AI explanations
# If left empty, FinSentinel automatically uses its built-in expert deterministic explanation engine.
GEMINI_API_KEY=

# Upload Configuration
MAX_IMAGE_SIZE_MB=5
MAX_TRANSACTION_CSV_SIZE_MB=5
MAX_TRANSACTION_CSV_ROWS=5000

# Pre-seeded Showcase Profile (Aditya Sharma)
DEMO_USER_EMAIL=demo@finsentinel.local
DEMO_USER_PASSWORD=FinSentinel@2026
